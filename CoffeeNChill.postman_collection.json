              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partitionKey\": \"HotDrinks\",\n  \"rowKey\": \"coffee001\",\n  \"name\": \"Cappuccino\",\n  \"description\": \"Espresso with steamed milk and foam\",\n  \"price\": 35.00,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
